# Copy to subtree-remotes.env (gitignored) and fill in after creating empty GitHub repos.
#
#   cp scripts/subtree-remotes.example.env scripts/subtree-remotes.env
#
# Monorepo (development): https://github.com/Nicolas-12000/Pilo
#
PILO_BACKEND_REMOTE=https://github.com/Nicolas-12000/pilo-backend.git
PILO_FRONTEND_REMOTE=https://github.com/Nicolas-12000/pilo-frontend.git
PILO_WORKER_REMOTE=https://github.com/Nicolas-12000/pilo-worker.git

# Branch to publish (default main)
PILO_PUBLISH_BRANCH=main
