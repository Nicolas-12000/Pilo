# Copy to pilo-backend/.env (gitignored). Point this at your existing Postgres.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pilo
SPRING_DATASOURCE_USERNAME=pilo
SPRING_DATASOURCE_PASSWORD=pilo
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

PILO_JWT_SECRET=change-me-to-a-256-bit-secret-key!!
PILO_JWT_EXPIRATION=24h
SERVER_ADDRESS=0.0.0.0
PILO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

PILO_STORAGE_PROVIDER=local
PILO_PROCESSING_MODE=inline
PILO_STORAGE_PATH=./storage
PILO_INTERNAL_API_KEY=dev-internal-key
PILO_AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
