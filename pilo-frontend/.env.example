NEXT_PUBLIC_API_URL=http://localhost:8080

# Canonical site URL for sitemap, Open Graph and metadata (no trailing slash).
# Amplify: set to your app URL, e.g. https://main.d1234.amplifyapp.com
# NEXT_PUBLIC_SITE_URL=

# Amplify: server-side proxy in next.config.ts (console cannot rewrite to http:// EC2).
# Set in amplify.yml — NOT NEXT_PUBLIC_* (browser stays same-origin on /api).
# PILO_BACKEND_ORIGIN=http://YOUR_ELASTIC_IP

# Shows the one-click demo login shortcuts on the login page. Keep this unset/false in any
# shared, staging, or production deployment — only enable for local development.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true
