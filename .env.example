# Copy to .env in this folder, pilo-backend/.env and pilo-frontend/.env.local
# If you already have PostgreSQL in Docker, only change the SPRING_DATASOURCE_* values.

POSTGRES_DB=pilo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pilo
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

PILO_JWT_SECRET=dev-only-change-me-to-a-256-bit-secret-key!!
PILO_JWT_EXPIRATION=24h
SERVER_ADDRESS=0.0.0.0
PILO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local demo (sin AWS)
PILO_STORAGE_PROVIDER=local
PILO_PROCESSING_MODE=inline
PILO_STORAGE_PATH=./storage
PILO_INTERNAL_API_KEY=dev-internal-key
PILO_AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

NEXT_PUBLIC_API_URL=http://localhost:8080

# --- AWS production (perfil aws) ---
# SPRING_PROFILES_ACTIVE=aws
# PILO_STORAGE_PROVIDER=s3
# PILO_PROCESSING_MODE=external
# PILO_S3_BUCKET=pilo-docs-your-env
# AWS_REGION=eu-west-1
